-- | Core data types, mathematical calculations, and virtual share offset logic
-- for Canton Vault instances.
module CantonVault.Types where

import Splice.Api.Token.HoldingV1

-- | Unique Identifier for a Canton Vault instance.
data VaultId = VaultId
  with
    provider : Party
    id : Text
  deriving (Eq, Show)

-- | Vault Configuration Parameters.
data VaultConfig = VaultConfig
  with
    vaultId : VaultId
    underlyingInstrument : InstrumentId
    shareInstrument : InstrumentId
    decimalsOffset : Int  -- ^ Virtual Share Offset (default: 3 -> 10^3)
    regulatorObservers : [Party] -- ^ Designated regulatory observer nodes
  deriving (Eq, Show)

-- | Vault Statistics & Exchange Rate Metrics.
data VaultStats = VaultStats
  with
    totalAssets : Decimal
    totalShares : Decimal
    sharePrice : Decimal  -- ^ Assets per share
  deriving (Eq, Show)

-- | Public NAV Data metric visible across Canton Web3 Network.
data PublicVaultNAVData = PublicVaultNAVData
  with
    vaultId : VaultId
    totalAssets : Decimal
    totalShares : Decimal
    sharePrice : Decimal
    idleAssets : Decimal
    strategyAssets : Decimal
  deriving (Eq, Show)

-- | Default virtual share offset exponent (3 gives 10^3 = 1000 virtual shares).
defaultOffsetExponent : Int
defaultOffsetExponent = 3

-- | Calculate virtual offset value 10^exponent.
calcOffset : Int -> Decimal
calcOffset exp =
  if exp <= 0 then 1.0
  else 10.0 * calcOffset (exp - 1)

-- | Calculate shares to mint for a given deposit asset amount.
-- Virtual Shares Math:
-- shares = (assets * (totalShares + 10^offset)) / (totalAssets + 1)
-- Truncates at Daml Decimal fixed precision (10 decimal places = 10^-10 atomic units).
convertToShares : Decimal -> Decimal -> Decimal -> Int -> Decimal
convertToShares depositAssets totalAssets totalShares offsetExp =
  let virtualShares = totalShares + calcOffset offsetExp
      virtualAssets = totalAssets + 1.0
  in (depositAssets * virtualShares) / virtualAssets

-- | Calculate underlying assets to return for a given share redemption amount.
-- Virtual Assets Math:
-- assets = (shares * (totalAssets + 1)) / (totalShares + 10^offset)
-- Truncates at Daml Decimal fixed precision (10 decimal places = 10^-10 atomic units).
convertToAssets : Decimal -> Decimal -> Decimal -> Int -> Decimal
convertToAssets redeemShares totalAssets totalShares offsetExp =
  let virtualShares = totalShares + calcOffset offsetExp
      virtualAssets = totalAssets + 1.0
  in (redeemShares * virtualAssets) / virtualShares
