-- | Daml Script Test Suite for Canton Vaults.
module CantonVault.Test.VaultSpec where

import Daml.Script
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import CIP0056.SimpleHolding
import CantonVault.Types
import CantonVault.VaultState
import CantonVault.Strategy
import CantonVault.PublicNAV
import CantonVault.Compliance
import CantonVault.RedeemWorkflow

-- | Helper to construct test instrument IDs.
makeInstrument : Party -> Text -> InstrumentId
makeInstrument admin id =
  InstrumentId with
    admin
    id

-- | Comprehensive test covering Deposit, Yield Harvest, and Share Redemption.
testVaultLifecycle : Script ()
testVaultLifecycle = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  alice <- allocatePartyByHint (PartyIdHint "Alice")
  publicParty <- allocatePartyByHint (PartyIdHint "PublicNetworkObserver")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "YieldVault-USDC-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  -- Initialize VaultState with Alice as observer
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = [alice]
      publicObservers = [publicParty]
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- Mint 1000.0 USDC for Alice
  aliceAssetCid <- submit (actAs [provider, alice]) do
    createCmd SimpleHolding with
      admin = provider
      owner = alice
      instrumentId = usdc
      amount = 1000.0
      meta = emptyMetadata

  -- Alice deposits 1000.0 USDC into Vault
  (vaultStateCid2, aliceShareCid) <- submit (actAs [alice, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = alice
      inputAssetHoldingCid = aliceAssetCid
      depositAmount = 1000.0
      complianceAttestationCid = None

  -- Verify VaultState after Alice deposit
  stats1 <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_GetStats with caller = provider
  assertMsg "Assets should be 1000.0" (stats1.totalAssets == 1000.0)

  -- Provider mints 500.0 USDC yield generated by strategy
  yieldHoldingCid <- submit provider do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 500.0
      meta = emptyMetadata

  -- Provider harvests 500.0 USDC yield from strategy and merges into physical asset pool
  vaultStateCid3 <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_HarvestYield with
      yieldAmount = 500.0
      returnedYieldHoldingCid = Some yieldHoldingCid

  -- Verify share price increased (1500.0 assets / totalShares = 0.0015 > 0.001)
  stats2 <- submit provider do
    exerciseCmd vaultStateCid3 VaultState_GetStats with caller = provider
  assertMsg "Total assets should be 1500.0" (stats2.totalAssets == 1500.0)
  assertMsg "Share price should increase after yield harvest" (stats2.sharePrice > stats1.sharePrice)

  -- Alice creates a RedeemRequest (2-step workflow)
  redeemReqCid <- submit (actAs [alice, provider]) do
    createCmd RedeemRequest with
      provider
      redeemer = alice
      vaultStateCid = vaultStateCid3
      inputShareHoldingCid = aliceShareCid
      sharesToRedeem = 1000000.0

  -- Provider accepts RedeemRequest
  (vaultStateCid4, _) <- submit (actAs [provider, alice]) do
    exerciseCmd redeemReqCid RedeemRequest_Accept

  -- Verify final VaultState
  stats3 <- submit provider do
    exerciseCmd vaultStateCid4 VaultState_GetStats with caller = provider
  assertMsg "Vault remaining assets should be <= 1.0" (stats3.totalAssets <= 1.0)

-- | Comprehensive test verifying Institutional Compliance, Allowlisting, Sanctions Blacklisting, Party Freeze, and Forced Escrow Liquidation.
testInstitutionalComplianceAndSanctions : Script ()
testInstitutionalComplianceAndSanctions = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  regulator <- allocatePartyByHint (PartyIdHint "SEC_RegulatorObserver")
  complianceOfficer <- allocatePartyByHint (PartyIdHint "ComplianceOfficer")
  institutionA <- allocatePartyByHint (PartyIdHint "InstitutionA")
  taintedParty <- allocatePartyByHint (PartyIdHint "TaintedParty")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "InstVault-Compliance-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = [regulator]

  -- 1. Initialize permissioned vault with SEC regulator observer
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = True
      allowlist = [institutionA, taintedParty]
      sanctionedParties = []
      frozenParties = []
      observers = [institutionA]
      publicObservers = []
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- 2. Compliance officer issues ComplianceAttestation for InstitutionA & TaintedParty
  attestationA <- submit complianceOfficer do
    createCmd ComplianceAttestation with
      issuer = complianceOfficer
      subject = institutionA
      isKycApproved = True
      isAmlCleared = True
      isSanctionsScreened = True
      jurisdiction = "US"

  attestationTainted <- submit complianceOfficer do
    createCmd ComplianceAttestation with
      issuer = complianceOfficer
      subject = taintedParty
      isKycApproved = True
      isAmlCleared = True
      isSanctionsScreened = True
      jurisdiction = "EU"

  -- Mint holdings
  assetA <- submit (actAs [provider, institutionA]) do
    createCmd SimpleHolding with
      admin = provider
      owner = institutionA
      instrumentId = usdc
      amount = 5000.0
      meta = emptyMetadata

  assetTainted <- submit (actAs [provider, taintedParty]) do
    createCmd SimpleHolding with
      admin = provider
      owner = taintedParty
      instrumentId = usdc
      amount = 2000.0
      meta = emptyMetadata

  -- 3. InstitutionA deposits 5000 USDC cleanly
  (vaultStateCid2, _) <- submit (actAs [institutionA, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = institutionA
      inputAssetHoldingCid = assetA
      depositAmount = 5000.0
      complianceAttestationCid = Some attestationA

  -- 4. TaintedParty deposits 2000 USDC cleanly initially
  (vaultStateCid3, taintedShareCid) <- submit (actAs [taintedParty, provider]) do
    exerciseCmd vaultStateCid2 VaultState_Deposit with
      depositor = taintedParty
      inputAssetHoldingCid = assetTainted
      depositAmount = 2000.0
      complianceAttestationCid = Some attestationTainted

  -- Fetch exact shares minted for TaintedParty
  Some taintedSharesHolding <- queryContractId provider taintedShareCid

  -- 5. Post-Deposit Tainted Event: Compliance Officer adds TaintedParty to Sanctions Blacklist & Freezes account
  vaultStateCid4 <- submit provider do
    exerciseCmd vaultStateCid3 VaultState_UpdateSanctionedParties with
      partyToBlacklist = taintedParty
      blacklisted = True

  -- 6. TaintedParty attempts to redeem -> submitMustFail because of sanctions blacklist!
  submitMustFail (actAs [taintedParty, provider]) do
    exerciseCmd vaultStateCid4 VaultState_Redeem with
      redeemer = taintedParty
      inputShareHoldingCid = taintedShareCid
      sharesToRedeem = taintedSharesHolding.amount

  -- 7. Compliance Officer exercises Forced Escrow Liquidation under legal order
  (vaultStateCid5, escrowCid) <- submit (actAs [provider, taintedParty]) do
    exerciseCmd vaultStateCid4 VaultState_ForceRedeemSanctioned with
      sanctionedParty = taintedParty
      inputShareHoldingCid = taintedShareCid
      sharesToRedeem = taintedSharesHolding.amount
      reason = "OFAC Sanctions List Enforced - Seized to Escrow"

  -- 8. Verify escrow holding created for compliance officer (provider)
  Some escrowHolding <- queryContractId provider escrowCid
  assertMsg "Escrow holding amount should be > 1999.0" (escrowHolding.amount > 1999.0)

  -- Verify remaining vault assets are around 5000.0 USDC (InstitutionA's funds remaining clean)
  stats <- submit provider do
    exerciseCmd vaultStateCid5 VaultState_GetStats with caller = provider
  assertMsg "Remaining total assets should be > 4999.0" (stats.totalAssets > 4999.0)

-- | Comprehensive test verifying 2-Step Strategy Allocation, Yield Harvesting, NAV Boost, and Share Redemption.
testStrategyYieldCycle : Script ()
testStrategyYieldCycle = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  strategyParty <- allocatePartyByHint (PartyIdHint "YieldStrategyAdapter")
  investor <- allocatePartyByHint (PartyIdHint "Investor")
  publicParty <- allocatePartyByHint (PartyIdHint "PublicNetworkObserver")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "CantonVault-USDC-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  -- 1. Initialize VaultState
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = [investor]
      publicObservers = [publicParty]
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- 2. Mint 1000.0 USDC for Investor
  investorAssetCid <- submit (actAs [provider, investor]) do
    createCmd SimpleHolding with
      admin = provider
      owner = investor
      instrumentId = usdc
      amount = 1000.0
      meta = emptyMetadata

  -- 3. Investor deposits 1000.0 USDC into Vault
  (vaultStateCid2, investorShareCid) <- submit (actAs [investor, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = investor
      inputAssetHoldingCid = investorAssetCid
      depositAmount = 1000.0
      complianceAttestationCid = None

  -- 4. Provider proposes 800.0 USDC allocation to external Yield Strategy (2-step proposal)
  (vaultStateCid3, reqCid) <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_ProposeStrategyAllocation with
      strategyParty
      strategyId = "Canton-Strategy-Pool-01"
      amountToAllocate = 800.0

  -- 5. Strategy accepts allocation request
  (allocationCid, _) <- submit (actAs [strategyParty, provider]) do
    exerciseCmd reqCid StrategyAllocationRequest_Accept

  -- 6. Strategy generates 100.0 USDC yield and returns 800 principal + 100 yield holdings to provider
  returnedPrincipalHoldingCid <- submit (actAs [provider, strategyParty]) do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 800.0
      meta = emptyMetadata

  returnedYieldHoldingCid <- submit (actAs [provider, strategyParty]) do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 100.0
      meta = emptyMetadata

  -- 7. Strategy returns principal to provider
  principalHoldingCid <- submit (actAs [strategyParty, provider]) do
    exerciseCmd allocationCid Strategy_DeallocatePrincipal with
      returnedPrincipalHoldingCid
      principalAmountToReturn = 800.0

  -- 8. VaultProvider de-allocates strategy principal, resetting strategyAssets to 0 and restocking idle pool
  vaultStateCid4 <- submit provider do
    exerciseCmd vaultStateCid3 VaultState_DeallocateFromStrategy with
      principalAmount = 800.0
      returnedPrincipalHoldingCid = principalHoldingCid

  -- 9. VaultProvider harvests 100.0 USDC yield into VaultState
  vaultStateCid5 <- submit provider do
    exerciseCmd vaultStateCid4 VaultState_HarvestYield with
      yieldAmount = 100.0
      returnedYieldHoldingCid = Some returnedYieldHoldingCid

  -- 10. Verify NAV and share price boost (+10% gain)
  stats <- submit provider do
    exerciseCmd vaultStateCid5 VaultState_GetStats with caller = provider
  assertMsg "Total assets should be 1100.0 USDC" (stats.totalAssets == 1100.0)
  assertMsg "Share price should be 0.0011 USDC/share" (stats.sharePrice == 0.0011)

  -- 11. Investor redeems shares and collects 1000 deposit + earned yield
  (vaultStateCid6, investorEarnedAssetCid) <- submit (actAs [investor, provider]) do
    exerciseCmd vaultStateCid5 VaultState_Redeem with
      redeemer = investor
      inputShareHoldingCid = investorShareCid
      sharesToRedeem = 1000000.0

  -- Verify investor received > 1000.0 USDC
  Some investorAssetHolding <- queryContractId investor investorEarnedAssetCid
  assertMsg "Investor returned assets should be > 1000.0 USDC" (investorAssetHolding.amount > 1000.0)

-- | Regression Test: Verify HarvestYield rejects mismatched yield holding amounts.
testHarvestYieldUTXOMismatchFails : Script ()
testHarvestYieldUTXOMismatchFails = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "SecurityVault-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 1000.0
      totalShares = 1000000.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = []
      publicObservers = []
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- Provider creates holding of 100.0 USDC
  mismatchedHoldingCid <- submit provider do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 100.0
      meta = emptyMetadata

  -- Must fail because yieldAmount (500.0) does not match yieldHolding.amount (100.0)
  submitMustFail provider do
    exerciseCmd vaultStateCid VaultState_HarvestYield with
      yieldAmount = 500.0
      returnedYieldHoldingCid = Some mismatchedHoldingCid

-- | Regression Test: Verify Strategy De-allocation & Idle Pool Restocking.
testStrategyDeallocationAndLiquidityRebalance : Script ()
testStrategyDeallocationAndLiquidityRebalance = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  strategyParty <- allocatePartyByHint (PartyIdHint "YieldStrategyAdapter")
  investor <- allocatePartyByHint (PartyIdHint "Investor")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "DeallocationVault-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  -- 1. Initialize VaultState
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = [investor]
      publicObservers = []
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- 2. Investor deposits 1000.0 USDC
  investorAssetCid <- submit (actAs [provider, investor]) do
    createCmd SimpleHolding with
      admin = provider
      owner = investor
      instrumentId = usdc
      amount = 1000.0
      meta = emptyMetadata

  (vaultStateCid2, _) <- submit (actAs [investor, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = investor
      inputAssetHoldingCid = investorAssetCid
      depositAmount = 1000.0
      complianceAttestationCid = None

  -- 3. Provider allocates 800.0 USDC to strategy
  (vaultStateCid3, reqCid) <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_ProposeStrategyAllocation with
      strategyParty
      strategyId = "Canton-Lending-Pool-01"
      amountToAllocate = 800.0

  (allocationCid, _) <- submit (actAs [strategyParty, provider]) do
    exerciseCmd reqCid StrategyAllocationRequest_Accept

  -- 4. Strategy de-allocates 800.0 USDC principal back to VaultProvider
  returnedPrincipalCid <- submit (actAs [provider, strategyParty]) do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 800.0
      meta = emptyMetadata

  principalHoldingCid <- submit (actAs [strategyParty, provider]) do
    exerciseCmd allocationCid Strategy_DeallocatePrincipal with
      returnedPrincipalHoldingCid = returnedPrincipalCid
      principalAmountToReturn = 800.0

  -- 5. VaultProvider de-allocates strategy principal, reducing strategyAssets to 0 and restocking idle pool
  vaultStateCid4 <- submit provider do
    exerciseCmd vaultStateCid3 VaultState_DeallocateFromStrategy with
      principalAmount = 800.0
      returnedPrincipalHoldingCid = principalHoldingCid

  -- 6. Verify strategyAssets is 0.0 and totalAssets is 1000.0
  navData <- submit provider do
    exerciseCmd vaultStateCid4 VaultState_GetPublicNAVData with caller = provider
  assertMsg "Strategy assets should be 0.0" (navData.strategyAssets == 0.0)
  assertMsg "Idle assets should be 1000.0" (navData.idleAssets == 1000.0)

-- | Test verifying Public NAV Disclosure accessible by any unprivileged public party across Canton.
testPublicNAVQuery : Script ()
testPublicNAVQuery = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  publicParty <- allocatePartyByHint (PartyIdHint "PublicNetworkObserver")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "PublicNAV-Vault-01"
      navData = PublicVaultNAVData with
        vaultId
        totalAssets = 1500000.0
        totalShares = 1000000.0
        sharePrice = 1.5
        idleAssets = 500000.0
        strategyAssets = 1000000.0

  -- Provider publishes PublicVaultNAV contract instance with publicObservers
  pubNavCid <- submit provider do
    createCmd PublicVaultNAV with
      provider
      navData
      publicObservers = [publicParty]

  -- Public party (unprivileged observer) queries real-time NAV statistics
  queriedNav <- submit publicParty do
    exerciseCmd pubNavCid PublicVaultNAV_GetStats with caller = publicParty

  assertMsg "Public NAV totalAssets should match" (queriedNav.totalAssets == 1500000.0)
  assertMsg "Public NAV sharePrice should be 1.5" (queriedNav.sharePrice == 1.5)

-- | Test verifying partial spends (change UTXOs), partial redemptions, and precise NAV calculations.
testPartialOperationsAndNAV : Script ()
testPartialOperationsAndNAV = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  bob <- allocatePartyByHint (PartyIdHint "Bob")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "YieldVault-Bob-01"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  -- Initialize empty vault
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = [bob]
      publicObservers = []
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- Mint 2000.0 USDC for Bob
  bobAssetCid <- submit (actAs [provider, bob]) do
    createCmd SimpleHolding with
      admin = provider
      owner = bob
      instrumentId = usdc
      amount = 2000.0
      meta = emptyMetadata

  -- Bob deposits partial amount 500.0 USDC out of 2000.0 USDC
  (vaultStateCid2, bobShareCid) <- submit (actAs [bob, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = bob
      inputAssetHoldingCid = bobAssetCid
      depositAmount = 500.0
      complianceAttestationCid = None

  -- Verify vault state after deposit
  stats1 <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_GetStats with caller = provider
  assertMsg "Total assets should be 500.0" (stats1.totalAssets == 500.0)
  assertMsg "Total shares should be 500000.0" (stats1.totalShares == 500000.0)

  -- Provider mints 250.0 USDC yield
  yieldHoldingCid <- submit provider do
    createCmd SimpleHolding with
      admin = provider
      owner = provider
      instrumentId = usdc
      amount = 250.0
      meta = emptyMetadata

  -- Provider harvests 250.0 USDC yield
  vaultStateCid3 <- submit provider do
    exerciseCmd vaultStateCid2 VaultState_HarvestYield with
      yieldAmount = 250.0
      returnedYieldHoldingCid = Some yieldHoldingCid

  -- Verify NAV updated accurately: 750.0 assets / 500,000 shares = 0.0015
  stats2 <- submit provider do
    exerciseCmd vaultStateCid3 VaultState_GetStats with caller = provider
  assertMsg "NAV totalAssets should be 750.0" (stats2.totalAssets == 750.0)
  assertMsg "Share price should be 0.0015" (stats2.sharePrice == 0.0015)

  -- Bob redeems partial 200,000 shares out of 500,000 shares
  (vaultStateCid4, _) <- submit (actAs [bob, provider]) do
    exerciseCmd vaultStateCid3 VaultState_Redeem with
      redeemer = bob
      inputShareHoldingCid = bobShareCid
      sharesToRedeem = 200000.0

  -- Verify remaining vault assets and shares
  stats3 <- submit provider do
    exerciseCmd vaultStateCid4 VaultState_GetStats with caller = provider
  assertMsg "Remaining shares should be 300000.0" (stats3.totalShares == 300000.0)
  assertMsg "Remaining assets should be positive" (stats3.totalAssets > 0.0)

-- | Test verifying immunity & protection against inflation rounding attacks.
testInflationProtection : Script ()
testInflationProtection = script do
  provider <- allocatePartyByHint (PartyIdHint "VaultProvider")
  attacker <- allocatePartyByHint (PartyIdHint "Attacker")
  victim <- allocatePartyByHint (PartyIdHint "Victim")

  let usdc = makeInstrument provider "USDC"
      vUsdc = makeInstrument provider "vUSDC"
      vaultId = VaultId with provider, id = "YieldVault-Protected"
      config = VaultConfig with
        vaultId
        underlyingInstrument = usdc
        shareInstrument = vUsdc
        decimalsOffset = defaultOffsetExponent
        regulatorObservers = []

  -- Initialize empty vault
  vaultStateCid <- submit provider do
    createCmd VaultState with
      config
      totalAssets = 0.0
      totalShares = 0.0
      isPaused = False
      isPermissioned = False
      allowlist = []
      sanctionedParties = []
      frozenParties = []
      observers = [attacker, victim]
      publicObservers = []
      vaultAssetHoldingCid = None
      strategyAssets = 0.0

  -- Attacker mints micro deposit of 1.0 USDC
  attackerAssetCid <- submit (actAs [provider, attacker]) do
    createCmd SimpleHolding with
      admin = provider
      owner = attacker
      instrumentId = usdc
      amount = 1.0
      meta = emptyMetadata

  -- Attacker deposits 1.0 USDC
  (vaultStateCid2, _) <- submit (actAs [attacker, provider]) do
    exerciseCmd vaultStateCid VaultState_Deposit with
      depositor = attacker
      inputAssetHoldingCid = attackerAssetCid
      depositAmount = 1.0
      complianceAttestationCid = None

  -- Victim deposits 1000.0 USDC
  victimAssetCid <- submit (actAs [provider, victim]) do
    createCmd SimpleHolding with
      admin = provider
      owner = victim
      instrumentId = usdc
      amount = 1000.0
      meta = emptyMetadata

  (_, _) <- submit (actAs [victim, provider]) do
    exerciseCmd vaultStateCid2 VaultState_Deposit with
      depositor = victim
      inputAssetHoldingCid = victimAssetCid
      depositAmount = 1000.0
      complianceAttestationCid = None

  pure ()
